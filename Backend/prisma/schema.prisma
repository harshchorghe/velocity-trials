// Velocity Trials — game persistence schema.
//
// Design notes:
//  * SQLite does not support Prisma enums, so status/power/weapon fields are
//    plain strings validated by the constants in src/game/constants.ts.
//  * Anything that a client could replay or double-submit is protected by a
//    real database unique constraint (see ClueSolve, CrystalCollect, BossHit)
//    rather than by an application-level "check then write", which would be
//    racy under concurrent requests.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Player {
  id         String   @id @default(cuid())
  name       String
  phone      String   @unique
  rollNumber String   @unique
  department String
  year       String
  createdAt  DateTime @default(now())

  sessions GameSession[]

  @@index([department])
}

model GameSession {
  id       String @id @default(cuid())
  token    String @unique
  playerId String
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  status       String @default("ACTIVE") // ACTIVE | COMPLETED | ELIMINATED
  currentLevel Int    @default(1)

  // Emulated partial unique index: holds the playerId while this session is
  // ACTIVE and is set to NULL once it ends. SQLite treats NULLs as distinct in
  // a unique index, so this enforces "at most one ACTIVE session per player"
  // in the database itself — two concurrent /session/start calls cannot both win.
  activeMarker String? @unique

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  level1 Level1Progress?
  level2 Level2Progress?
  level3 Level3Progress?
  events GameEvent[]

  @@index([playerId])
  @@index([status])
}

model Level1Progress {
  id        String      @id @default(cuid())
  sessionId String      @unique
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?

  solvedCount  Int @default(0)
  clueAttempts Int @default(0)
  codeAttempts Int @default(0)

  qualified Boolean @default(false)
  rank      Int?

  solves ClueSolve[]

  @@index([qualified])
}

// Seeded reference data. answerCode is the secret the player must find in the
// real world — it is never included in any client-facing payload.
model Clue {
  id         String  @id @default(cuid())
  index      Int     @unique // 1..3
  text       String
  answerCode String
  location   String?
}

model ClueSolve {
  id       String         @id @default(cuid())
  level1Id String
  level1   Level1Progress @relation(fields: [level1Id], references: [id], onDelete: Cascade)

  clueIndex Int
  solvedAt  DateTime @default(now())

  // Makes solving a clue idempotent: a replayed or concurrent duplicate submit
  // hits this constraint instead of incrementing solvedCount twice.
  @@unique([level1Id, clueIndex])
}

model Level2Progress {
  id        String      @id @default(cuid())
  sessionId String      @unique
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  power             String // SPRINT | JUMP | FLIGHT
  lives             Int    @default(3)
  crystalsCollected Int    @default(0)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int?
  lastHitAt   DateTime?

  qualified Boolean @default(false)
  failed    Boolean @default(false)
  rank      Int?

  crystals CrystalCollect[]

  @@index([qualified])
}

model CrystalCollect {
  id       String         @id @default(cuid())
  level2Id String
  level2   Level2Progress @relation(fields: [level2Id], references: [id], onDelete: Cascade)

  crystalIndex Int
  collectedAt  DateTime @default(now())

  // Same idempotency guarantee as ClueSolve: a crystal can only ever be
  // banked once per player, no matter how many times the client reports it.
  @@unique([level2Id, crystalIndex])
}

model Level3Progress {
  id        String      @id @default(cuid())
  sessionId String      @unique
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  weapon   String?
  bossHp   Int     @default(100)
  playerHp Int     @default(100)

  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  durationMs   Int?
  lastActionAt DateTime?

  won      Boolean @default(false)
  champion Boolean @default(false)

  hits BossHit[]

  @@index([champion])
}

model BossHit {
  id       String         @id @default(cuid())
  level3Id String
  level3   Level3Progress @relation(fields: [level3Id], references: [id], onDelete: Cascade)

  seq    Int // client-supplied monotonic action number
  action String
  damage Int
  at     DateTime @default(now())

  // Retrying an attack with the same seq cannot apply damage twice.
  @@unique([level3Id, seq])
}

model GameEvent {
  id        String       @id @default(cuid())
  sessionId String?
  session   GameSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  type    String
  payload String?
  at      DateTime @default(now())

  @@index([type])
  @@index([at])
}

model GameSetting {
  key   String @id
  value String
}
